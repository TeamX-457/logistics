# Which settings module to load. Defaults to local (SQLite + in-memory
# Channels + eager Celery, zero external services) if unset — see
# manage.py / logistica_tracking/asgi.py / logistica_tracking/wsgi.py.
# Set to logistica_tracking.settings.production for a real deployment.
DJANGO_SETTINGS_MODULE=logistica_tracking.settings.local

# --- Required in production only (settings/production.py raises a clear
# error at startup if any of these are missing) ---------------------------
SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=*

DB_NAME=logistica_tracking
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Used for both Django Channels (live tracking/notifications) and Celery
# (accept-conflict resolution) in production.
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of origins the frontend/RN app is served from.
CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# --- Optional, sensible defaults apply if unset ---------------------------
# Window during which two drivers accepting the same job are treated as a
# simultaneous conflict requiring admin resolution.
ACCEPT_CONFLICT_WINDOW_SECONDS=1.0

# Minimum spacing between GPS pings persisted to Postgres for trip history.
# Every ping still updates Redis immediately for live tracking.
LOCATION_DB_WRITE_INTERVAL_SECONDS=60
