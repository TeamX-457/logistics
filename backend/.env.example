SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to sqlite if unset. Example for Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/logisticspro
DATABASE_URL=sqlite:///db.sqlite3

# Only needed if a separate client (e.g. a Next.js dev server) calls this API.
# The bundled frontend at / is same-origin and doesn't need an entry here.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to True and provide REDIS_URL to use Redis as the Channels layer in production.
USE_REDIS_CHANNEL_LAYER=False
REDIS_URL=redis://127.0.0.1:6379/0

# Sign in with Google — create an OAuth client at console.cloud.google.com
# (Credentials > OAuth client ID > Web application) and set its authorized
# JavaScript origin to this app's URL. Only the client ID is used by the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
